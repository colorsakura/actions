formulas:
  Untitled: ""
views:
  - type: table
    name: Table
    filters:
      and:
        - '!file.path.startsWith("assets")'
        - file.path != "90-Wiki"
        - file.ext == "md"
        - "!/\\d{4}-\\d{2}-\\d{2}/.matches(file.name)"
    order:
      - file.name
      - file.path
    columnSize:
      file.name: 359
